<Window
    x:Class="ElvaraOSTools.MainWindow"
    xmlns:views="clr-namespace:ElvaraOSTools.Views"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    WindowStartupLocation="CenterScreen"
    Width="1024" Height="640"
    Background="#1E1E2E"
    Title="ElvaraOS Tools">
    <Border Margin="12">
        <TabControl>
            <TabItem Header="主页">
                <views:WelcomePage />
            </TabItem>
            <TabItem Header="包管理增强">
                <views:PMEPage />
            </TabItem>
            <TabItem Header="NVIDIA 专区">
                <views:NvidiaPage />
            </TabItem>
            <TabItem Header="系统维护">
                <views:MaintPage />
            </TabItem>
            <TabItem Header="系统服务">
                <views:ServicesPage />
            </TabItem>
        </TabControl>
    </Border>
</Window>
