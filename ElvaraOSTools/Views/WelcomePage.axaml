<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sukiUi="clr-namespace:SukiUI.Controls;assembly=SukiUI"
             mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="640"
             x:Class="ElvaraOSTools.Views.WelcomePage">
    <Grid Margin="16,12,16,16" ColumnDefinitions="Auto,*" RowDefinitions="*">

        <!-- 左侧：系统概览 -->
        <ScrollViewer Grid.Column="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <sukiUi:GlassCard Padding="16,14,16,16" VerticalAlignment="Top">
                <StackPanel Orientation="Vertical" Spacing="0">
                    <!-- 标题行 + 按钮 -->
                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,8">
                        <TextBlock Grid.Column="0"
                                   Text="系统概览"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Opacity="0.9"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1"
                                x:Name="BtnRefresh"
                                Content="↻"
                                FontSize="14"
                                Padding="6,2"
                                Margin="6,0,0,0"
                                ToolTip.Tip="刷新"
                                Classes="Flat" />
                        <Button Grid.Column="2"
                                x:Name="BtnCopy"
                                Content="⎘"
                                FontSize="14"
                                Padding="6,2"
                                Margin="4,0,0,0"
                                ToolTip.Tip="复制信息"
                                Classes="Flat" />
                    </Grid>
                    <Border Height="1" Background="#28FFFFFF" Margin="0,0,0,10" />
                    <Grid x:Name="InfoGrid" ColumnDefinitions="Auto,12,*" />
                </StackPanel>
            </sukiUi:GlassCard>
        </ScrollViewer>

        <!-- 右侧：监控面板 -->
        <ScrollViewer Grid.Column="1"
                      Margin="12,0,0,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Vertical" Spacing="10">

                <!-- 启动时间 -->
                <sukiUi:GlassCard Padding="16,14,16,16">
                    <StackPanel Spacing="0">
                        <TextBlock Text="启动时间" FontSize="13" FontWeight="Bold" Opacity="0.9" Margin="0,0,0,8"/>
                        <Border Height="1" Background="#28FFFFFF" Margin="0,0,0,10"/>
                        <StackPanel x:Name="UptimePanel" Spacing="4"/>
                    </StackPanel>
                </sukiUi:GlassCard>

                <!-- 缓存占用 -->
                <sukiUi:GlassCard Padding="16,14,16,16">
                    <StackPanel Spacing="0">
                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                            <TextBlock Grid.Column="0" Text="内存缓存" FontSize="13" FontWeight="Bold" Opacity="0.9" VerticalAlignment="Center"/>
                            <Button Grid.Column="1"
                                    x:Name="BtnDropCache"
                                    Content="一键清理"
                                    FontSize="12"
                                    Padding="8,3"
                                    Classes="Flat" />
                        </Grid>
                        <Border Height="1" Background="#28FFFFFF" Margin="0,0,0,10"/>
                        <StackPanel x:Name="CachePanel" Spacing="6"/>
                    </StackPanel>
                </sukiUi:GlassCard>

                <!-- 温度监控 -->
                <sukiUi:GlassCard Padding="16,14,16,16">
                    <StackPanel Spacing="0">
                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                            <TextBlock Grid.Column="0" Text="温度监控" FontSize="13" FontWeight="Bold" Opacity="0.9" VerticalAlignment="Center"/>
                            <Button Grid.Column="1"
                                    x:Name="BtnRefreshTemp"
                                    Content="↻"
                                    FontSize="14"
                                    Padding="6,2"
                                    Classes="Flat" />
                        </Grid>
                        <Border Height="1" Background="#28FFFFFF" Margin="0,0,0,10"/>
                        <StackPanel x:Name="TempPanel" Spacing="6"/>
                    </StackPanel>
                </sukiUi:GlassCard>

            </StackPanel>
        </ScrollViewer>

    </Grid>
</UserControl>
