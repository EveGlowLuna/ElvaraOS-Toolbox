<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sukiUi="clr-namespace:SukiUI.Controls;assembly=SukiUI"
             mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="640"
             x:Class="ElvaraOSTools.Views.NvidiaPage">
    <TabControl x:Name="MainTabs" Margin="8">

        <!-- 检测驱动 / 显卡 -->
        <TabItem Header="检测驱动 / 显卡">
            <Grid RowDefinitions="*,Auto" Margin="8">
                <sukiUi:GlassCard Grid.Row="0" Padding="8">
                    <ScrollViewer>
                        <TextBlock x:Name="DetectText" FontFamily="monospace" FontSize="12"
                                   TextWrapping="Wrap" Opacity="0.85" Text="切换到此标签页自动检测…"/>
                    </ScrollViewer>
                </sukiUi:GlassCard>
                <Border Grid.Row="1" Padding="4,6">
                    <TextBlock x:Name="DetectStatus" FontSize="11" Opacity="0.5" Text="就绪"/>
                </Border>
            </Grid>
        </TabItem>

        <!-- 推荐驱动安装 -->
        <TabItem Header="推荐驱动安装">
            <Grid RowDefinitions="Auto,*,Auto" Margin="8">
                <sukiUi:GlassCard Grid.Row="0" Padding="12,8" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="BtnInstallDriver" Content="安装推荐驱动" Classes="Accent" Padding="14,6" IsVisible="False"/>
                    </StackPanel>
                </sukiUi:GlassCard>
                <sukiUi:GlassCard Grid.Row="1" Padding="8">
                    <ScrollViewer>
                        <TextBlock x:Name="RecommendText" FontFamily="monospace" FontSize="12"
                                   TextWrapping="Wrap" Opacity="0.85" Text="切换到此标签页自动分析…"/>
                    </ScrollViewer>
                </sukiUi:GlassCard>
                <Border Grid.Row="2" Padding="4,6">
                    <TextBlock x:Name="RecommendStatus" FontSize="11" Opacity="0.5" Text="就绪"/>
                </Border>
            </Grid>
        </TabItem>

        <!-- CUDA 支持 -->
        <TabItem Header="CUDA 支持">
            <Grid RowDefinitions="Auto,*,Auto" Margin="8">
                <sukiUi:GlassCard Grid.Row="0" Padding="12,8" Margin="0,0,0,8">
                    <Button x:Name="BtnInstallCuda" Content="安装 cuda + cudnn" Classes="Accent" Padding="14,6" IsVisible="False"/>
                </sukiUi:GlassCard>
                <sukiUi:GlassCard Grid.Row="1" Padding="8">
                    <ScrollViewer>
                        <TextBlock x:Name="CudaText" FontFamily="monospace" FontSize="12"
                                   TextWrapping="Wrap" Opacity="0.85" Text="切换到此标签页自动检测…"/>
                    </ScrollViewer>
                </sukiUi:GlassCard>
                <Border Grid.Row="2" Padding="4,6">
                    <TextBlock x:Name="CudaStatus" FontSize="11" Opacity="0.5" Text="就绪"/>
                </Border>
            </Grid>
        </TabItem>

        <!-- Prime 渲染切换 -->
        <TabItem Header="Prime 渲染切换">
            <Grid RowDefinitions="*,Auto" Margin="8">
                <sukiUi:GlassCard Grid.Row="0" Padding="8">
                    <ScrollViewer>
                        <TextBlock x:Name="PrimeText" FontFamily="monospace" FontSize="12"
                                   TextWrapping="Wrap" Opacity="0.85" Text="切换到此标签页自动检测…"/>
                    </ScrollViewer>
                </sukiUi:GlassCard>
                <Border Grid.Row="1" Padding="4,6">
                    <TextBlock x:Name="PrimeStatus" FontSize="11" Opacity="0.5" Text="就绪"/>
                </Border>
            </Grid>
        </TabItem>

        <!-- 生成 Xorg 配置 -->
        <TabItem Header="生成 Xorg 配置">
            <Grid RowDefinitions="Auto,*,Auto" Margin="8">
                <sukiUi:GlassCard Grid.Row="0" Padding="12,8" Margin="0,0,0,8">
                    <Button x:Name="BtnWriteXorg" Content="写入配置文件" Classes="Accent" Padding="14,6"/>
                </sukiUi:GlassCard>
                <sukiUi:GlassCard Grid.Row="1" Padding="8">
                    <ScrollViewer>
                        <TextBlock x:Name="XorgText" FontFamily="monospace" FontSize="12"
                                   TextWrapping="Wrap" Opacity="0.85" Text="切换到此标签页查看配置内容…"/>
                    </ScrollViewer>
                </sukiUi:GlassCard>
                <Border Grid.Row="2" Padding="4,6">
                    <TextBlock x:Name="XorgStatus" FontSize="11" Opacity="0.5" Text="就绪"/>
                </Border>
            </Grid>
        </TabItem>

        <!-- nvidia-settings -->
        <TabItem Header="nvidia-settings">
            <Grid RowDefinitions="Auto,*" Margin="8">
                <sukiUi:GlassCard Grid.Row="0" Padding="12,8" Margin="0,0,0,8">
                    <Button x:Name="BtnLaunchSettings" Content="启动 nvidia-settings" Classes="Accent" Padding="14,6"/>
                </sukiUi:GlassCard>
                <sukiUi:GlassCard Grid.Row="1" Padding="8">
                    <TextBlock x:Name="SettingsText" FontSize="12" Opacity="0.7"
                               TextWrapping="Wrap"
                               Text="点击上方按钮启动 nvidia-settings 图形界面。&#10;&#10;若未安装，请先执行：&#10;  sudo pacman -S nvidia-settings"/>
                </sukiUi:GlassCard>
            </Grid>
        </TabItem>

    </TabControl>
</UserControl>
