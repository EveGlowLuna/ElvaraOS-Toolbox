<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sukiUi="clr-namespace:SukiUI.Controls;assembly=SukiUI"
             xmlns:local="clr-namespace:ElvaraOSTools.Views"
             mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="640"
             x:Class="ElvaraOSTools.Views.ServicesPage">
    <Grid Margin="8" RowDefinitions="Auto,*">

        <!-- 工具栏 -->
        <sukiUi:GlassCard Grid.Row="0" Padding="10,8" Margin="0,0,0,8">
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto">
                <TextBlock Grid.Column="0" Text="系统服务" FontSize="14" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                <!-- 状态筛选 -->
                <ComboBox x:Name="FilterBox" Grid.Column="1" Width="130" Margin="0,0,8,0"
                          SelectedIndex="0">
                    <ComboBoxItem Content="全部"/>
                    <ComboBoxItem Content="active"/>
                    <ComboBoxItem Content="failed"/>
                    <ComboBoxItem Content="enabled"/>
                    <ComboBoxItem Content="disabled"/>
                </ComboBox>
                <Button x:Name="BtnRefresh" Grid.Column="2" Content="刷新"
                        Classes="Flat" Padding="10,6" Margin="0,0,8,0"/>
                <Button x:Name="BtnBlame" Grid.Column="3" Content="启动耗时分析"
                        Classes="Flat" Padding="10,6"/>
                <!-- spacer -->
                <TextBlock Grid.Column="4"/>
                <TextBox x:Name="SearchBox" Grid.Column="5" Watermark="搜索服务名…"
                         Width="180" Margin="0,0,8,0"/>
                <TextBlock x:Name="CountLabel" Grid.Column="6" FontSize="11" Opacity="0.5"
                           VerticalAlignment="Center"/>
            </Grid>
        </sukiUi:GlassCard>

        <!-- 主体：左侧列表 + 右侧详情 -->
        <Grid Grid.Row="1" ColumnDefinitions="*,320">

            <!-- 服务列表 -->
            <sukiUi:GlassCard Grid.Column="0" Padding="0" Margin="0,0,8,0">
                <Grid RowDefinitions="*,Auto">
                    <ListBox x:Name="ServiceList" Grid.Row="0" Margin="4">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="local:ServiceItem">
                                <Grid ColumnDefinitions="16,*,80,80" Margin="4,2">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding StatusDot}" FontSize="10"
                                               Foreground="{Binding StatusColor}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}"
                                               FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding ActiveState}"
                                               FontSize="11" Opacity="0.6" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{Binding SubState}"
                                               FontSize="11" Opacity="0.5" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="#18FFFFFF" Padding="12,5">
                        <TextBlock x:Name="ListStatus" FontSize="11" Opacity="0.5" Text="加载中…"/>
                    </Border>
                </Grid>
            </sukiUi:GlassCard>

            <!-- 右侧详情 + 操作 + 日志 -->
            <sukiUi:GlassCard Grid.Column="1" Padding="0">
                <Grid RowDefinitions="Auto,Auto,*">
                    <!-- 服务名 -->
                    <Border Grid.Row="0" Padding="12,10" BorderThickness="0,0,0,1" BorderBrush="#18FFFFFF">
                        <TextBlock x:Name="DetailName" Text="选择一个服务"
                                   FontSize="13" FontWeight="Bold" TextWrapping="Wrap"/>
                    </Border>
                    <!-- 操作按钮 -->
                    <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="8,6" HorizontalAlignment="Left">
                        <Button x:Name="BtnStart"   Content="启动"  Classes="Accent" Padding="10,5" Margin="0,0,4,4" IsEnabled="False"/>
                        <Button x:Name="BtnStop"    Content="停止"  Classes="Flat"   Padding="10,5" Margin="0,0,4,4" IsEnabled="False"/>
                        <Button x:Name="BtnRestart" Content="重启"  Classes="Flat"   Padding="10,5" Margin="0,0,4,4" IsEnabled="False"/>
                        <Button x:Name="BtnEnable"  Content="启用"  Classes="Flat"   Padding="10,5" Margin="0,0,4,4" IsEnabled="False"/>
                        <Button x:Name="BtnDisable" Content="禁用"  Classes="Flat"   Padding="10,5" Margin="0,0,4,4" IsEnabled="False"/>
                        <Button x:Name="BtnStatus"  Content="状态"  Classes="Flat"   Padding="10,5" Margin="0,0,4,4" IsEnabled="False"/>
                    </WrapPanel>
                    <!-- 日志输出 -->
                    <ScrollViewer Grid.Row="2" x:Name="LogScroll" Margin="8,0,8,8">
                        <TextBlock x:Name="LogText" FontFamily="monospace" FontSize="11"
                                   TextWrapping="Wrap" Opacity="0.8"
                                   Text="选择服务后点击「状态」查看日志"/>
                    </ScrollViewer>
                </Grid>
            </sukiUi:GlassCard>
        </Grid>
    </Grid>
</UserControl>
